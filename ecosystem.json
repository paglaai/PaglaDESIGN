  "documentation": {
    "sources": [
      {
        "id": "pagladesign",
        "repo": "paglaai/pagladesign",
        "path": "/",
        "role": "authority"
      },
      {
        "id": "paglaai.space",
        "repo": "paglaai/paglaai.space",
        "path": "docs/",
        "role": "surface"
      },
      {
        "id": "paglaai-docs",
        "repo": "paglaai/paglaai-docs",
        "path": "/",
        "role": "unified-docs"
      }
    ],
    "rendererContract": "design-system/RENDERER_API.md",
    "rendererSpec": "governance/AUDIENCE_RENDERER_SPEC.md",
    "renderers": {
      "fern": {
        "audience": "human",
        "output": "html",
        "spec": "design-system/FERN_RENDERER.md",
        "consumer": "paglaai.space"
      },
      "machine": {
        "audience": "machine",
        "output": ["json", "openapi", "mcp-bundle", "prompt-bundle"],
        "spec": "design-system/MACHINE_RENDERER.md",
        "consumer": "ci/mcp/static-site-generators"
      },
      "architect": {
        "audience": "architect",
        "output": ["rfc", "adr", "governance", "audit-ui"],
        "spec": "design-system/ARCHITECT_RENDERER.md",
        "consumer": "sanctum/governance-ui"
      }
    },
    "frontmatter": {
      "required": ["title", "audience"],
      "optional": ["version", "status", "dependencies", "schema", "renderer"],
      "validation": "design-system/RENDERER_API.md#validation-rules"
    }
  },
  "pipelines": {
    "githubToCloudflare": {
      "description": "PaglaDESIGN → Cloudflare Pages CI/CD chain",
      "trigger": {
        "repo": "paglaai/pagladesign",
        "event": "push to main",
        "paths": ["design-system/**", "css/**", "ecosystem.json", "brand/**"]
      },
      "steps": [
        {
          "name": "validate-tokens",
          "action": ".github/actions/build-tokens",
          "inputs": {
            "tokens_path": "design-system/DESIGN_TOKENS.md",
            "css_output_path": "css/tokens.css"
          }
        },
        {
          "name": "validate-ecosystem",
          "action": "validate-ecosystem",
          "inputs": {
            "registry": "ecosystem.json",
            "schema": "ecosystem.schema.json"
          }
        },
        {
          "name": "validate-frontmatter",
          "action": "validate-frontmatter",
          "inputs": {
            "contract": "design-system/RENDERER_API.md"
          }
        },
        {
          "name": "deploy-pages",
          "provider": "cloudflare-pages",
          "note": "PaglaDESIGN Pages preview (planned) — mirrors paglaai.space deploy.yml"
        },
        {
          "name": "dispatch-downstream",
          "event": "design.updated",
          "targets": ["paglaai/paglaai.space", "paglaai/paglaai-docs", "paglaai/sanctum"],
          "note": "repository_dispatch to trigger consumer rebuilds"
        }
      ]
    },
    "release": {
      "description": "PaglaOS ecosystem release workflow",
      "trigger": {
        "event": "release published",
        "workflow": ".github/workflows/release.yml"
      },
      "artifacts": ["pagladesign-assets.tar.gz", "ecosystem.json", "css/tokens.css"],
      "publish": "softprops/action-gh-release@v2"
    }
  },
  "roadmap": {
    "issue": "https://github.com/paglaai/pagladesign/issues/3",
    "phases": [
      {
        "phase": 1,
        "title": "PaglaDESIGN v2.0 Foundation",
        "status": "active",
        "deliverables": [
          "PaglaDESIGN v2.0 documentation (RENDERER_API.md, AUDIENCE_RENDERER_SPEC.md)",
          "Human / Machine / Architect modes (FERN_RENDERER.md, MACHINE_RENDERER.md, ARCHITECT_RENDERER.md)",
          "Ecosystem registry (ecosystem.json) — this file"
        ]
      },
      {
        "phase": 2,
        "title": "SANCTUM + Shell + B3K4R",
        "status": "planned",
        "deliverables": [
          "SANCTUM Runtime repository (public architecture repo)",
          "PaglaSHELL CLI roadmap",
          "B3K4R MVP documentation"
        ]
      },
      {
        "phase": 3,
        "title": "Automation & Release",
        "status": "planned",
        "deliverables": [
          "GitHub Actions automation (validate-tokens, validate-ecosystem, validate-frontmatter)",
          "Cloudflare Pages deployment (PaglaDESIGN preview + paglaai-docs)",
          "Release workflow for PaglaOS ecosystem (assets + ecosystem.json)",
          "design.updated event pipeline to downstream repos"
        ]
      }
    ]
  }
}
