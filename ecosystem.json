  "documentation": {
    "sources": [
      {
        "id": "pagladesign",
        "repo": "paglaai/PaglaDESIGN",
        "path": "/",
        "role": "authority"
      },
      {
        "id": "paglaai.space",
        "repo": "paglaai/paglaai.space",
        "path": "docs/",
        "role": "surface"
      },
      {
        "id": "paglaai-docs",
        "repo": "paglaai/paglaai-docs",
        "path": "/",
        "role": "unified-docs"
      }
    ],
    "designDna": "design-system/DESIGN_DNA.md",
    "rendererContract": "design-system/RENDERER_API.md",
    "renderers": {
      "fern": {
        "audience": "human",
        "output": "html",
        "spec": "design-system/FERN_RENDERER.md",
        "consumer": "paglaai.space"
      },
      "machine": {
        "audience": "machine",
        "output": ["json", "openapi", "mcp-bundle", "prompt-bundle"],
        "spec": "design-system/MACHINE_RENDERER.md"
      },
      "architect": {
        "audience": "architect",
        "output": ["rfc", "adr", "governance", "audit-ui"],
        "spec": "design-system/ARCHITECT_RENDERER.md"
      }
    }
  },
  "pipelines": {
    "githubToCloudflare": {
      "description": "PaglaDESIGN → consumer rebuild chain",
      "trigger": {
        "repo": "paglaai/PaglaDESIGN",
        "event": "push to main",
        "paths": ["design-system/**", "css/**", "ecosystem.json", "brand/**"]
      },
      "steps": [
        {
          "name": "validate-tokens",
          "action": ".github/actions/build-tokens"
        },
        {
          "name": "dispatch-downstream",
          "event": "design.updated",
          "targets": ["paglaai/paglaai.space", "paglaai/paglaai-docs"],
          "workflow": ".github/workflows/dispatch-downstream.yml"
        }
      ]
    },
    "ecosystemReflection": {
      "description": "Public repos, releases, packages → website + apphole.store",
      "sources": ["github org public repos", "github releases", "npm/pypi packages when published"],
      "targets": ["paglaai.space product grid", "apphole.store catalog"],
      "rule": "Never hand-edit product lists that the generator owns"
    }
  },
  "roadmap": {
    "issue": "https://github.com/paglaai/pagladesign/issues/3",
    "phases": [
      {
        "phase": 1,
        "name": "PaglaDESIGN v2.0 Foundation",
        "status": "active",
        "deliverables": ["v2.0 documentation", "Human / Machine / Architect modes", "Ecosystem registry"]
      },
      {
        "phase": 2,
        "name": "SANCTUM + Shell + B3K4R",
        "status": "planned",
        "deliverables": ["SANCTUM Runtime repository", "PaglaSHELL CLI roadmap", "B3K4R MVP documentation"]
      },
      {
        "phase": 3,
        "name": "Automation & Release",
        "status": "planned",
        "deliverables": ["GitHub Actions automation", "Cloudflare Pages deployment", "Release workflow for PaglaOS", "design.updated event pipeline"]
      }
    ]
  }
}
